# これを .env にコピーして値を埋める(.env は .gitignore 済み)。
# シェルで読み込む例:  set -a; . ./.env; set +a

# Claude API キー(分析に必須)
ANTHROPIC_API_KEY=sk-ant-...

# Discord Webhook URL(通知に必須。--dry-run なら不要)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# 精査(deep)モデル(任意。既定: claude-opus-4-8)
# 大量処理のコストを抑えたい場合は claude-sonnet-4-6 等に変更可。
# YOSOKU_MODEL=claude-opus-4-8

# トリアージ(全件スクリーニング)モデル(任意。既定: claude-haiku-4-5)
# YOSOKU_TRIAGE_MODEL=claude-haiku-4-5
